{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/answer-recommended.mjs"],
            "timeout": 30,
            "statusMessage": "Réponse automatique (option recommandée)"
          }
        ]
      }
    ]
  }
}
